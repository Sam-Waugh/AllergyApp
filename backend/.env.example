# Environment Variables for Allergy App Backend

# Database Configuration
DATABASE_URL=sqlite:///./allergy_app.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/allergy_app

# JWT Secret Key for authentication
SECRET_KEY=your-super-secret-jwt-key-here-change-in-production

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Maps API Configuration
# Get your API key from: https://developers.google.com/maps/documentation/pollen/cloud-setup
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Optional: Other API keys for enhanced features
# OpenWeatherMap API (for weather data)
OPENWEATHER_API_KEY=your-openweather-api-key

# AirVisual API (for air quality data)
AIRVISUAL_API_KEY=your-airvisual-api-key

# Application Configuration
DEBUG=True
HOST=127.0.0.1
PORT=8090

# CORS Configuration
CORS_ORIGINS=http://localhost:8081,http://localhost:8084,http://localhost:19006

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

{
    "folders": [
        {
            "name": "Allergy App",
            "path": "."
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "./backend/venv/Scripts/python.exe",
        "python.terminal.activateEnvironment": true,
        "python.analysis.extraPaths": [
            "./backend",
            "./backend/venv/Lib/site-packages"

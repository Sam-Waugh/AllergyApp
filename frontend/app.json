{
  "expo": {
    "name": "SymplyAllergy",
    "slug": "symply-allergy",
    "version": "1.0.0",
    "orientation": "portrait",
    "sdkVersion": "53.0.0",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A9B9B"
    },
    "ios": {
      "supportsTablet": true,
      "config": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4A9B9B"
      },
      "edgeToEdgeEnabled": true,
      "config": {},
      "package": "com.anonymous.symplyallergy"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "build": {
        "babel": {
          "include": [
            "./web-build/static/css/custom.css"
          ]
        }
      },
      "bundler": "metro"
    }
  }
}
